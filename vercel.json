{
  "headers": [
    {
      "source": "/Build/(.*)\\.br",
      "headers": [
        { "key": "Content-Encoding", "value": "br" }
      ]
    },
    {
      "source": "/(.*)\\.wasm\\.br",
      "headers": [
        { "key": "Content-Type", "value": "application/wasm" }
      ]
    },
    {
			"source": "/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "max-age=0, no-cache, no-store, must-revalidate"
				}
			]
    }
  ]
}